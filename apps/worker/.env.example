# Database / auth (Supabase)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Telegram bot (for signal delivery)
TELEGRAM_BOT_TOKEN=

# Web push (generate with: npx web-push generate-vapid-keys)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=

# Cron schedule for each scan pass. No point polling more often than your
# fastest selected timeframe's candles actually close.
SCAN_CRON=*/5 * * * *
